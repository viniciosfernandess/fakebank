{
  "name": "fakebank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "customer:otp": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/customer-otp.mjs",
    "build": "vite build apps/web && tsc --noEmit -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "operator": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/operator-bank.mjs",
    "dispatch:separated-pix": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/separated-pix-dispatcher.mjs",
    "start:bank": "BANK_ONLY_MODE=1 node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types apps/server/src/main.ts",
    "start:lab": "FAULT_LAB_MODE=1 node --env-file-if-exists=.env --experimental-strip-types scripts/start-fault-lab.mjs",
    "reset:lab": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/reset-fault-lab.mjs",
    "start": "BANK_ONLY_MODE=1 node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --experimental-strip-types apps/server/src/main.ts",
    "start:ib": "node apps/ib/server.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs apps/ib/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/codex-sdk": "0.167.2",
    "fastify": "5.12.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
