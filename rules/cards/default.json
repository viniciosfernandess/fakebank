    { "id": "CARD-HIGH-RISK-CUSTOMER", "feature": "customer_risk_tier", "operator": "gte", "value": 2, "points": 150, "reason": "HIGH_RISK_CUSTOMER" },
    { "id": "CARD-NEW-CUSTOMER", "feature": "customer_tenure_days", "operator": "lt", "value": 7, "points": 100, "reason": "NEW_CUSTOMER" },
