{
  "version": 1,
  "thresholds": { "step_up": 650, "hold": 850, "decline": 1000 },
  "rules": [
    { "id": "PIX-FLAGGED-DESTINATION", "feature": "destination_flagged", "operator": "gte", "value": 1, "points": 1000, "reason": "DESTINATION_FRAUD_FLAG" },
    { "id": "PIX-NEW-DEVICE", "feature": "device_age_minutes", "operator": "lt", "value": 1440, "points": 200, "reason": "NEW_DEVICE" },
